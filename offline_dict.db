import sqlite3

def smart_offline_translate(self, text):
    cleaned = text.lower().strip()
    words = cleaned.split()
    translated_words = []
    
    try:
        conn = sqlite3.connect('offline_dict.db')
        cursor = conn.cursor()
        
        for w in words:
            cursor.execute("SELECT target_word FROM dictionary WHERE source_word=? AND src_lang=? AND tgt_lang=?", 
                           (w, self.source_lang, self.target_lang))
            res = cursor.fetchone()
            translated_words.append(res[0] if res else w)
        conn.close()
        return " ".join(translated_words)
    except Exception:
        # Fallback ძველ დიქშენარიზე
        return super().smart_offline_translate(text)
