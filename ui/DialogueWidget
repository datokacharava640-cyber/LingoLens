from kivy.uix.boxlayout import BoxLayout
from kivy.uix.button import Button
from kivy.uix.textinput import TextInput
from kivy.uix.label import Label
from kivy.clock import Clock
import config
from utils.translator import translate_text

class DialogueWidget(BoxLayout):
    def __init__(self, **kwargs):
        super().__init__(orientation='vertical', spacing=10, padding=10, **kwargs)
        font = getattr(config, 'FONT_PATH', None)

        # 1. ზედა ნაწილი: პირველი ადამიანი (მაგ. ინგლისური)
        top_box = BoxLayout(orientation='vertical', spacing=5)
        top_box.add_widget(Label(text="👤 Person A (English)", font_name=font, size_hint_y=0.2))
        self.input_a = TextInput(hint_text="Type here / Speak...", font_name=font, multiline=True)
        self.output_a = TextInput(hint_text="Translation (English)...", font_name=font, readonly=True, multiline=True)
        top_box.add_widget(self.input_a)
        top_box.add_widget(self.output_a)

        # 2. შუა ღილაკი: თარგმანი A -> B (ინგლისურიდან ქართულად)
        btn_translate_a = Button(text="Translate to Georgian ↓", font_name=font, size_hint_y=0.2)
        btn_translate_a.bind(on_press=self.translate_a_to_b)

        # 3. ქვედა ნაწილი: მეორე ადამიანი (მაგ. ქართული)
        bottom_box = BoxLayout(orientation='vertical', spacing=5)
        bottom_box.add_widget(Label(text="👤 Person B (ქართული)", font_name=font, size_hint_y=0.2))
        self.input_b = TextInput(hint_text="ჩაწერეთ აქ...", font_name=font, multiline=True)
        self.output_b = TextInput(hint_text="თარგმანი (ქართული)...", font_name=font, readonly=True, multiline=True)
        bottom_box.add_widget(self.input_b)
        bottom_box.add_widget(bottom_box.add_widget(self.output_b) if hasattr(bottom_box, 'add_widget') else self.output_b) # უსაფრთხოებისათვის

        # გასწორდა ქვედა ლეიაუთის სწორი მიმაგრება:
        bottom_box.clear_widgets()
        bottom_box.add_widget(Label(text="👤 Person B (ქართული)", font_name=font, size_hint_y=0.2))
        bottom_box.add_widget(self.input_b)
        bottom_box.add_widget(self.output_b)

        # 4. შუა ღილაკი: თარგმანი B -> A (ქართულიდან ინგლისურად)
        btn_translate_b = Button(text="Translate to English ↑", font_name=font, size_hint_y=0.2)
        btn_translate_b.bind(on_press=self.translate_b_to_a)

        # ვიჯეტების დამატება მთავარ ლეიაუთში
        self.add_widget(top_box)
        self.add_widget(btn_translate_a)
        self.add_widget(bottom_box)
        self.add_widget(btn_translate_b)

    def translate_a_to_b(self, instance):
        val = self.input_a.text.strip()
        if val:
            prompt = f"Translate accurately from English to Georgian: {val}"
            # ინგლისურიდან ქართულად თარგმნისას შედეგი უნდა ჩაჯდეს output_b-ში
            translate_text(
                prompt, val, "en", "ka", 
                lambda res: Clock.schedule_once(lambda dt: setattr(self.output_b, 'text', res))
            )

    def translate_b_to_a(self, instance):
        val = self.input_b.text.strip()
        if val:
            prompt = f"Translate accurately from Georgian to English: {val}"
            # ქართულიდან ინგლისურად თარგმნისას შედეგი უნდა ჩაჯდეს output_a-ში
            translate_text(
                prompt, val, "ka", "en", 
                lambda res: Clock.schedule_once(lambda dt: setattr(self.output_a, 'text', res))
            )
